# Application
APP_ENV=development
APP_NAME=parali-to-cbg-marketplace
TIMEZONE=Asia/Kolkata

# PostgreSQL + PostGIS
POSTGRES_DB=parali_marketplace
POSTGRES_USER=parali_app
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+asyncpg://parali_app:change_me_local_only@localhost:5432/parali_marketplace

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
