# API application
APP_ENV=development
APP_NAME=parali-to-cbg-marketplace
TIMEZONE=Asia/Kolkata
API_HOST=0.0.0.0
API_PORT=8000

# Database and Redis
DATABASE_URL=postgresql+asyncpg://parali_app:change_me_local_only@localhost:5432/parali_marketplace
REDIS_URL=redis://localhost:6379/0

# Authentication - replace with a secure local value when configuring the API
JWT_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP development settings
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Routing
OSRM_BASE_URL=http://localhost:5000
